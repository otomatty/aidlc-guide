{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@tests/*": ["./tests/*"],
      "@/components/ui": ["./src/shared/ui"],
      "@/components/ui/*": ["./src/shared/ui/*"],
      "@/store/*": ["./src/shared/store/*"],
      "@/hooks/*": ["./src/shared/hooks/*"],
      "@/services/*": ["./src/shared/services/*"],
      "@/lib/*": ["./src/shared/lib/*"],
      "@/data/*": ["./src/shared/data/*"],
      "@/styles/*": ["./src/shared/styles/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "vite.config.ts"],
  // The base config excludes this package (it is the browser one); that
  // exclusion must not follow us in here.
  "exclude": ["node_modules", "dist"]
}
