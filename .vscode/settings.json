{
  "files.associations": {
    "**/packages/dashboard/src/styles/globals.css": "tailwindcss"
  },
  "tailwindCSS.experimental.configFile": "packages/dashboard/src/styles/globals.css",
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[markdown][yaml][github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "prettier.requireConfig": true
}
