#!/bin/sh
# Local quality gate — the one that actually runs, since this project has no
# hosted CI by default (team.md).
#
# Install deliberately, it is not wired up for you:
#   cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# What it does: runs `bun run check` and refuses the push if it fails.
# What it does NOT do: modify files, stage anything, or amend commits. A hook
# that rewrites your work while you are trying to push it is worse than no hook.
#
# Bypass with `git push --no-verify` when you must — but the gate exists
# because nothing downstream will catch what it catches.
set -e

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun is not on PATH. Skipping the gate would hide real failures," >&2
  echo "          so this push is refused. Install bun, or use --no-verify knowingly." >&2
  exit 1
fi

echo "pre-push: running the quality gate (bun run check)..."
if ! bun run check; then
  echo "" >&2
  echo "pre-push: the gate failed — push refused." >&2
  echo "          Read the failure above before re-running. Most failures are" >&2
  echo "          real and a second run will not fix them." >&2
  echo "          One exception is known: git packs objects while this runs, so" >&2
  echo "          on a large push the test environment can be starved into a" >&2
  echo "          timeout. If you see a timeout AND an 'environment' duration" >&2
  echo "          far above normal, re-run 'bun run check' alone to tell the" >&2
  echo "          two apart." >&2
  exit 1
fi

echo "pre-push: gate passed."
