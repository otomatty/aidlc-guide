{
  "name": "aidlc-guide",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run check:docs-index && bun run check:workflows-compatibility && bun run test:coverage && bun run check:audit-shards && bun run audit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "bun run lint:oxlint && bun run lint:workflows",
    "lint:oxlint": "oxlint",
    "lint:workflows": "bun scripts/lint-workflows.ts",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/dashboard && tsc --noEmit -p packages/vscode-extension",
    "check:docs-index": "bun scripts/build-docs-index.ts --check",
    "check:workflows-compatibility": "bun scripts/check-workflows-compatibility.ts",
    "check:audit-shards": "bun scripts/check-audit-shards.ts",
    "audit": "bun audit",
    "build:dashboard": "vite build packages/dashboard",
    "build:dashboard:webview": "vite build packages/dashboard --mode webview",
    "build:official-docs-media": "bun scripts/copy-official-docs-media.ts",
    "build:docs-index": "bun scripts/build-docs-index.ts",
    "docs:search": "bun packages/official-docs/src/cli.ts search",
    "build:artifact-map": "bun scripts/build-artifact-map.ts",
    "build:extension": "bun run build:dashboard:webview && bun run build:official-docs-media && bun run --cwd packages/vscode-extension build",
    "package:extension": "bun run build:extension && bun run --cwd packages/vscode-extension package",
    "dashboard": "bun run build:dashboard && bun packages/dashboard-server/src/cli.ts"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.3.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.83.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "brace-expansion": "^5.0.9",
    "dompurify": "^3.4.13",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.5",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "qs": "^6.16.0"
  }
}
